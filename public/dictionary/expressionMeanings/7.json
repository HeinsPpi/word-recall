[{"id":"m_8c9dc4d0e43b8cc4f752","expressionId":"x_6168d576bc095d58a1de","language":"ja","text":"バス停留所","source":"DiQt"},{"id":"m_40cbe4e9d623d29e1625","expressionId":"x_b032a8abd93a9cb1816c","language":"ja","text":"（人・物など）の隣に, ...に接して / ...の次に /  [否定語の前に用いて]ほとんど...だ / ...に比べると","source":"DiQt"},{"id":"m_1952e7607bdefa89e82a","expressionId":"x_c95178638cabd3e85558","language":"ja","text":"不定冠詞(a, an)","source":"DiQt"},{"id":"m_0c0d5a1104588aac6ff8","expressionId":"x_c5552170b6bcb204134e","language":"ja","text":"〈C〉《英》小学校(2年の幼児学校(infant school)と4年の下級学校(junior school)を合わせたもの) / 〈U〉《米》elementary schoolの最初の4年間 / 〈U〉児童の教育;初級教育","source":"DiQt"},{"id":"m_e96355b2e87add89019e","expressionId":"x_5f1e0bccf45e41aacf68","language":"ja","text":"事実上[の]","source":"DiQt"},{"id":"m_e38ee16f73712ae4bb11","expressionId":"x_34a6cef25d040fce6966","language":"ja","text":"デビットカード,即時決済カード","source":"DiQt"},{"id":"m_fb8e4a944ef7a96039d1","expressionId":"x_d2a82dc14e67c579eed0","language":"ja","text":"北極グマ,白クマ","source":"DiQt"},{"id":"m_04dbbaa9f7bea6ff6bf0","expressionId":"x_62f29b1c856bfb6c7898","language":"ja","text":"《...に》帰ってくる,戻る《to ...》","source":"PHaVE"},{"id":"m_18c0b3282e739f04d287","expressionId":"x_d7411f04d55d30d51b5f","language":"ja","text":"をみつけだす, をつきとめる","source":"PHaVE"},{"id":"m_f425231414aa8d49b60e","expressionId":"x_599dea6aec373d409e10","language":"ja","text":"《...の》代理になる《for ...》 / 《…について》（人）に詳細を伝える《on ...》 / を埋める,をふさぐ,を塗りつぶす,を書き入れる","source":"PHaVE"},{"id":"m_f745c24ff09902f05f45","expressionId":"x_a5b37d4691f506b0fcc8","language":"ja","text":"【句動】強大になる,増える,渋滞する； を強大にする, を徐々に増大する","source":"PHaVE"},{"id":"m_0bb59278edb49350b80d","expressionId":"x_9be229f761256029b8bb","language":"ja","text":"を掲げる / （良い状態で）持ちこたえる / を遅らせる,を阻む / 強盗する","source":"PHaVE"},{"id":"m_763208dc2c9705cddf74","expressionId":"x_a8faaccd9225c36281bd","language":"ja","text":"【句動】を降ろす,を墜落させる / （価格・数値など）を下げる,を減じる / を打ち倒す,を失脚させる","source":"PHaVE"},{"id":"m_dcd3ee8df6c28a939aff","expressionId":"x_b6995e10e7b5ee34b8be","language":"ja","text":"...の側の / （人）の方の","source":"PHRASE"},{"id":"m_5ad451028812cfabff9e","expressionId":"x_9d7425049ce78f97b5b0","language":"ja","text":"《最上級・比較級の形容詞・副詞を強調して》はるかに, 断然, 圧倒的に","source":"PHRASE"},{"id":"m_081c25e5c647def13fd7","expressionId":"x_fd327fc01d791359249c","language":"ja","text":"《書》《予定》...することになっている / 《意志》...するつもりである / 《運命》...する運命にある /《義務》...しなければならない / 《可能》...できる","source":"PHRASE"},{"id":"m_ead16a168554b0d190df","expressionId":"x_2992085f68834548a36a","language":"ja","text":"売りに出て, 売りに出されて","source":"PHRASE"},{"id":"m_1e6ca14acdd408ce9b81","expressionId":"x_7970fb3b7a816d5a35ef","language":"ja","text":"...の観点から / （単位）に換算して / 《話》...することを, ...したいということを","source":"PHRASE"},{"id":"m_14b241998f5a9d8849b7","expressionId":"x_fe737b547fcbe58827a8","language":"ja","text":"【形】パートタイムの, 非常勤の, 定時制の【副】パートタイムで, 非常勤で","source":"PHRASE"},{"id":"m_2b1c6c56419d3d669f43","expressionId":"x_fb63e99a8d1faf6e9a93","language":"ja","text":"（仕事など）を始める, にとりかかる / ...に向かう / 《be ~ 》...することになっている","source":"PHRASE"},{"id":"m_82bcfcd3f9023246895b","expressionId":"x_9b90887d1e2510b2cd18","language":"ja","text":"《…を》 引き続き調べる, 追求する, 究明する 《on》","source":"PHRASE"},{"id":"m_54ebd4e8cccec9ce1d42","expressionId":"x_7c56ca8f66770ad21624","language":"ja","text":"...に変わる, ...へと転じる, ...へと変質する","source":"PHRASE"},{"id":"m_2544b72012ac52242b8c","expressionId":"x_675ecb0525c4ee8162ba","language":"ja","text":"いいかい, よく聞いてよ / でもね, でも断っておくけど, 念のため言っておくけど / 一言付け加えておくと, ちなみに / 気をつけろ","source":"PHRASE"},{"id":"m_5dfb500c73be12277096","expressionId":"x_2858207e8a490f66289a","language":"ja","text":"...時半, ...時30分すぎ","source":"PHRASE"},{"id":"m_3aae0f697ad5d8a91f95","expressionId":"x_1a66c820e3afc03e93f8","language":"ja","text":"全体としては, 全体的に見ると, 概して","source":"PHRASE"},{"id":"m_f79b73a562a110d6a344","expressionId":"x_599dea6aec373d409e10","language":"ja","text":"《...の》代理になる《for ...》 / 《…について》（人）に詳細を伝える《on ...》 / を埋める,をふさぐ,を塗りつぶす,を書き入れる","source":"PHRASE"},{"id":"m_22e233e514834c200c0f","expressionId":"x_3a3c8086399c7ee0180b","language":"ja","text":"（まとめて、物）を製作する / （情報などを集めて、計画など）を出す / （バラバラにされた部品など）を組み立てる / （人を集めて、グループなど）を編成する","source":"PHRASE"},{"id":"m_4447b32b4c5ea046d580","expressionId":"x_8dafde0e65ad2bf591ae","language":"ja","text":"（悪事）をしても罰を受けない, ...をしても捕まらない / ...を持って逃げる / ...でその場を切り抜ける","source":"PHRASE"},{"id":"m_01dee417725b5832d681","expressionId":"x_3406e25d5b5a76d8185e","language":"ja","text":"...だけではなく...も / 《接続詞的に》...同様に / ...と同じくらい上手に / ...する限りは","source":"PHRASE"},{"id":"m_f9cf9ab336701740cd5e","expressionId":"x_0f1c15024e09410a3336","language":"ja","text":"かつては, 一時は / 一斉に, 同時に","source":"PHRASE"},{"id":"m_a6fb340b79103844222c","expressionId":"x_244272a1d4f7ab9e0fd4","language":"ja","text":"を明確に説明する / を並べる, を広げる","source":"PHRASE"},{"id":"m_fe6aad175aef9e41aba2","expressionId":"x_1a66cc0b1570ee23fbce","language":"ja","text":"【名】前者","source":"PHRASE"},{"id":"m_9019b62623103f2d6557","expressionId":"x_fa73d7d040328cdb8eee","language":"ja","text":"《くだけた話》ちょっとした..., 相当な...","source":"PHRASE"},{"id":"m_2b825741f12cc143aca4","expressionId":"x_35e9a58bad45ac01e940","language":"ja","text":"今のところは, さしあたりは, 当座は","source":"PHRASE"},{"id":"m_bcf69acd624c1115d4a3","expressionId":"x_6d9ef2934a5d47d680f1","language":"ja","text":"特に,とりわけ / 格別に, 詳細に / 具体的には, 具体的に言うと","source":"PHRASE"},{"id":"m_a5d5c05c1b1fbe2766ba","expressionId":"x_d9c6399d00eec706d6f9","language":"ja","text":"...というよりもむしろ / ...ではなくて","source":"PHRASE"},{"id":"m_407d30d6ccefcdef0ed4","expressionId":"x_4553dee862f05c9fe2fa","language":"ja","text":"起きる, 立ち上がる","source":"PHRASE"},{"id":"m_b25f367b9fa0625e662f","expressionId":"x_6fdaf5143c1eb2f99dc1","language":"ja","text":"《be ~ 》...に知られている","source":"PHRASE"},{"id":"m_2af0950bdedcb83f3917","expressionId":"x_e4cf77dd85e1f5d0f1af","language":"ja","text":"を見つける,を発見する,に気づく / （音や熱など）を大きくする,を上げる / 現れる, 姿を現す","source":"PHRASE"},{"id":"m_19d965ffdbbc112ca354","expressionId":"x_4240428e10b53db4ecd1","language":"ja","text":"《肯定的に》 （人･事･物）のおかげで / 《否定的に》...のせいで","source":"PHRASE"},{"id":"m_8afbb7cc985d602265ee","expressionId":"x_6c99add150f6a6b75d60","language":"ja","text":"（人が）スイッチを入れる / （機械などが）スイッチが入る","source":"PHRASE"},{"id":"m_8efcde42955c0d5c7714","expressionId":"x_16395254e6f10a2390a1","language":"ja","text":"...を考えると, ...を考慮すると,だとすれば","source":"PHRASE"},{"id":"m_1d192f3902d963974e61","expressionId":"x_5edb9b761d56a9f48e69","language":"ja","text":"《前文の内容を受けて》もしもそうした場合には, もしそうなった場合には","source":"PHRASE"},{"id":"m_a8735416bb088a59436b","expressionId":"x_7e1b819a9770b8b322f1","language":"ja","text":"出る,  ...から出す,から逃げ出す《of ...》","source":"PHRASE"}]