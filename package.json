{
  "name": "word-recall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-dictionary.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:serve": "vite build --mode e2e && vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "dictionary:download": "node scripts/download_dictionary.mjs",
    "dictionary:build": "python3 scripts/build_dictionary.py",
    "dictionary:validate": "python3 scripts/validate_dictionary.py",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "chart.js": "4.5.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
